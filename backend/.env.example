# Copy to .env and adjust. .env is git-ignored and must never be committed.
# cp .env.example .env

# ---- Required ----
# Async SQLAlchemy URL. Local SQLite example; use postgresql+asyncpg://... in prod.
DATABASE_URL=sqlite+aiosqlite:///./cooking_app.db
# JWT signing key — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# ---- Application ----
DEBUG=false
# Develop default. Production sets SERVER_PORT in docker-compose (8089).
SERVER_PORT=8080
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=default

# ---- JWT (optional overrides) ----
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=90

# ---- Database pool (optional) ----
DB_ECHO=false
DB_POOL_SIZE=10
DB_TIMEOUT=5.0

# ---- Redis (sessions) ----
# Local `python main.py` with compose Redis published on host 6378:
REDIS_HOST=localhost
REDIS_PORT=6378
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_SSL=false
REDIS_DECODE_RESPONSES=true
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SESSION_PREFIX=session:
# If the API runs inside docker compose, use instead:
# REDIS_HOST=redis
# REDIS_PORT=6379


# ---- TLS in-container (optional; prefer terminating TLS at the reverse proxy) ----
SSL_ENABLED=false
# SSL_KEYFILE=certs/key.pem
# SSL_CERTFILE=certs/cert.pem
SSL_PORT=8443

# ---- Deploy (used by docker-compose / CI pull) ----
# Fully-qualified image reference to pull/run.
IMAGE=ghcr.io/alexis-trejo-11/cooking-recipes-api:latest
