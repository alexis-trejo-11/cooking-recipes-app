# Copy to .env and adjust. .env is git-ignored and must never be committed.

# ---- Runtime (read by the SSR Node server when the container starts) ----
# Public: injected into the browser HTML as window.__env (NOT a secret).
# Base URL of the backend API the browser calls.
API_BASE_URL=http://localhost:8080/api/v1
# Public base URL where the frontend is served.
BASE_URL=http://localhost:4200
# Comma-separated hostnames the server will accept. Use "*" to allow any host.
ALLOWED_HOSTS=localhost
# Port the SSR server listens on (develop: 4000). Production sets PORT in compose (4010).
PORT=4000

# ---- Deploy (used by docker-compose / CI) ----
# Fully-qualified image reference to pull/run.
IMAGE=ghcr.io/alexis-trejo-11/cooking-recipes-web:latest
